{
  "name": "global-conflict-v2",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "balance": "vitest run src/game/balanceHarness.test.ts --reporter=verbose",
    "app:sync": "npm run build && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "ios:doctor": "bash scripts/ios-doctor.sh",
    "ios:build": "bash scripts/ios-build.sh",
    "ios:run": "bash scripts/ios-run.sh",
    "ios:archive": "bash scripts/ios-archive.sh",
    "ios:clean": "bash scripts/ios-clean.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-globe.gl": "^2.27.3",
    "three": "^0.174.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.174.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  }
